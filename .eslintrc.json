{
  "env": {
    "browser": true,
    "es2020": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "ignorePatterns": [
    "node_modules/**",
    "out/**",
    "bin/**",
    "obj/**",
    "generated/**"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "warn"
  }
}
